{
  "name": "eigencast",
  "version": "0.1.0",
  "description": "Narrated, Manim-style explainer videos from a script and a canvas draw file. Built for coding agents.",
  "license": "MIT",
  "bin": {
    "eigencast": "src/cli/main.ts"
  },
  "exports": {
    "./draw": "./src/draw/index.ts",
    "./stage": "./src/stage/index.tsx",
    "./timeline": "./src/timeline/index.ts",
    "./theme": "./src/theme/index.ts"
  },
  "files": [
    "src",
    "fonts",
    "python/pyproject.toml",
    "python/uv.lock",
    "python/eigencast_voice/*.py",
    "skills",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
